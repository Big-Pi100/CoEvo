# CoEvo — 环境变量配置模板
# 复制为 .env 并填入实际值

# LLM API 配置（至少填一个）
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
# LLM_API_KEY=sk-fallback    # 备选 key 名
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-v4-flash

# 管理员密钥（管理员后台用）
# COEVO_ADMIN_KEY=my-admin-secret

# 数据路径（默认值适合开发环境）
# COEVO_DB_PATH=data/coevo.db
# COEVO_AVATAR_DIR=data/avatars
# COEVO_PROMPTS_DIR=prompts
# COEVO_WORDBANK_PATH=cefr_catalog.json

# 监听地址（默认 0.0.0.0:8080）
# COEVO_HOST=0.0.0.0
# COEVO_PORT=8080
