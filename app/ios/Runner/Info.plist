<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>记忆之书</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>coevo_app</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>EPUB Publication</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>org.idpf.epub-container</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Plain Text</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.plain-text</string>
			</array>
		</dict>
	</array>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>

	<!-- ═══════════════════════════════════════════════════════════════════
	     🔴 2026-10-07 iOS 真机首测修复
	     依据：docs/review/ios-device-first-run-findings-2026-10-07.md
	     ═══════════════════════════════════════════════════════════════════ -->

	<!-- 后台音频。
	     iOS 的「后台能力」是**硬性声明制**：不声明，App 一进后台/锁屏，
	     音频会话必被系统挂起 —— 表现为「朗读到一半就停」。
	     📌 判据：iOS 上「功能在后台不工作」先查 Info.plist，别查代码。
	     （白哥真机反馈 #3b） -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>

	<!-- 「文件」App 集成（🆕 2026-10-07 白哥定：要加）。
	     · UIFileSharingEnabled              → 「文件」App 的「我的 iPhone」下出现
	                                            CoEvo 文件夹，可直接把文件拖进去 / 删文件
	     · LSSupportsOpeningDocumentsInPlace → 「文件」App 显示**原文件**（而非副本），
	                                            并可直接用 CoEvo 打开
	     ⚠️ 生效前提是 App 确实在用 `Documents` 目录 —— 本项目是 `Documents/imports/`
	        （见 `services/open_with_handler.dart`：外部打开的文件会复制到这里）。
	     ✅ 已核实**数据库不在 Documents 下**：`user.db` / `word.db` / `book.db` 三个库
	        都在 `getApplicationSupportDirectory()`（`Library/Application Support/`）
	        ⇒ **不会**因本项暴露给用户（否则用户误删会导致 App 直接崩）。
	     📌 将来若把新数据写进 `Documents/`，要意识到它会**对用户可见**。 -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>

	<!-- 🔴 2026-10-07：`NSMicrophoneUsageDescription` 已**移除**（同日加、同日移除）。
	     原因：`record` 依赖一并移除了（见 `pubspec.yaml`）——
	     不再链接麦克风 API ⇒ **不需要**该声明；
	     留着反而会在审核时被问「你这个 App 到底用不用麦克风」。
	     📌 若将来真做录音：加回 `record` 依赖 + **同时**补回这个 key
	     （缺它时 iOS 不是报错，是**直接 kill 进程**）。 -->
</dict>
</plist>
