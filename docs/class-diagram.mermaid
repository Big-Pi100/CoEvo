classDiagram
    class Atom {
        +int index
        +string html
        +string text
        +string type
    }
    
    class PageRange {
        +int startIdx
        +int endIdx
        +float pretextHeight
        +float measuredHeight
        +bool overflow
    }
    
    class SmartPaginate {
        +smartPaginate(browser, atoms, pageHeight, options) PageRange[]
        +measureHeight(browser, html, viewportWidth) float
        +createPageHTML(atoms, startIdx, endIdx, wrapperFn, options) string
        +splitAtom(atom, pageHeight) Atom[]
    }
    
    class PretextPaginate {
        +smartPaginateWithPretext(browser, atoms, font, options) PageRange[]
        +prepareAtoms(atoms, font) Handle[]
        +estimateScrollHeight(pretextHeight, paragraphCount, brCount) float
        +getUsableHeight() float
    }
    
    class PretextEngine {
        +prepare(text, fontOptions) Handle
        +layout(handle, layoutOptions) LayoutResult
    }
    
    class LayoutResult {
        +float height
        +int lineCount
    }
    
    class CSSConstants {
        +int bodyPaddingTop = 44
        +int bodyPaddingBottom = 44
        +int paragraphPaddingTop = 38
        +int brMargin = 8
        +int contentWidth = 968
        +float lineHeight = 60.8
        +int decorativeLine = 20
        +int pageNumberArea = 36
        +int viewportHeight = 1440
    }
    
    SmartPaginate --> Atom : uses
    SmartPaginate --> PageRange : produces
    PretextPaginate --> Atom : uses
    PretextPaginate --> PageRange : produces
    PretextPaginate --> PretextEngine : delegates text measurement
    PretextPaginate --> CSSConstants : reads compensation parameters
    PretextPaginate --> SmartPaginate : reuses measureHeight
    PretextEngine --> LayoutResult : returns
